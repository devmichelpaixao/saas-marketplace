# Configurações do Servidor
NODE_ENV=development
PORT=3000
API_URL=http://192.168.1.11:3000

# Banco de Dados
DATABASE_URL="postgresql://usuario:senha@localhost:5432/saas_marketplace?schema=public"

# JWT
JWT_SECRET=sua_chave_secreta_super_segura_aqui_123456789
JWT_EXPIRES_IN=7d

# Sentry (obtenha em https://sentry.io)
# SENTRY_DSN=https://xxxxxx@oxxxx.ingest.sentry.io/xxxxxx
# SENTRY_DEV=false

# Multi-Tenancy (Desenvolvimento)
# Em desenvolvimento, use um subdomínio padrão ao acessar via localhost
DEV_TENANT_SUBDOMAIN=demo

# Redis (Rate Limiting & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS & Security
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://192.168.1.11:5173,http://192.168.1.11:3000
CORS_ORIGIN=http://192.168.1.11:5173

# Mercado Livre
ML_CLIENT_ID=seu_client_id_aqui
ML_CLIENT_SECRET=seu_client_secret_aqui
ML_REDIRECT_URI=http://192.168.1.11:3000/api/integrations/mercadolivre/callback

# Shopee
SHOPEE_PARTNER_ID=seu_partner_id_aqui
SHOPEE_PARTNER_KEY=sua_partner_key_aqui
SHOPEE_SHOP_ID=seu_shop_id_aqui

# Upload de Arquivos
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
