generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model categories {
  id               String       @id
  name             String
  description      String?
  parentId         String?
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime
  tenantId         String
  categories       categories?  @relation("categoriesTocategories", fields: [parentId], references: [id])
  other_categories categories[] @relation("categoriesTocategories")
  tenants          tenants      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products         products[]
}

model departments {
  id                                                          String             @id
  name                                                        String
  description                                                 String?
  order                                                       Int                @default(0)
  color                                                       String?
  active                                                      Boolean            @default(true)
  createdAt                                                   DateTime           @default(now())
  updatedAt                                                   DateTime
  tenantId                                                    String
  tenants                                                     tenants            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders                                                      orders[]
  products                                                    products[]
  tasks                                                       tasks[]
  user_departments                                            user_departments[]
  workflow_steps_workflow_steps_fromDepartmentIdTodepartments workflow_steps[]   @relation("workflow_steps_fromDepartmentIdTodepartments")
  workflow_steps_workflow_steps_toDepartmentIdTodepartments   workflow_steps[]   @relation("workflow_steps_toDepartmentIdTodepartments")
}

model listings {
  id                       String                   @id
  productId                String
  integrationId            String
  externalId               String
  title                    String
  description              String
  price                    Decimal                  @db.Decimal(10, 2)
  stock                    Int                      @default(0)
  status                   ListingStatus            @default(ACTIVE)
  url                      String?
  lastSyncAt               DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime
  marketplace_integrations marketplace_integrations @relation(fields: [integrationId], references: [id])
  products                 products                 @relation(fields: [productId], references: [id])
  order_items              order_items[]
  questions                questions[]

  @@unique([integrationId, externalId])
}

model marketplace_integrations {
  id           String          @id
  marketplace  MarketplaceType
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  shopId       String?
  active       Boolean         @default(true)
  config       Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime
  tenantId     String
  listings     listings[]
  tenants      tenants         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders       orders[]

  @@unique([tenantId, marketplace])
}

model messages {
  id          String        @id
  orderId     String
  userId      String?
  externalId  String?
  sender      MessageSender
  senderName  String
  content     String
  attachments Json?
  read        Boolean       @default(false)
  readAt      DateTime?
  createdAt   DateTime      @default(now())
  orders      orders        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  users       users?        @relation(fields: [userId], references: [id])
}

model order_items {
  id         String    @id
  orderId    String
  productId  String
  listingId  String?
  quantity   Int
  unitPrice  Decimal   @db.Decimal(10, 2)
  totalPrice Decimal   @db.Decimal(10, 2)
  createdAt  DateTime  @default(now())
  listings   listings? @relation(fields: [listingId], references: [id])
  orders     orders    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  products   products  @relation(fields: [productId], references: [id])
}

model order_status_history {
  id           String       @id
  orderId      String
  fromStatus   OrderStatus?
  toStatus     OrderStatus
  departmentId String?
  notes        String?
  createdAt    DateTime     @default(now())
  orders       orders       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model orders {
  id                              String                    @id
  integrationId                   String?
  externalId                      String?
  orderNumber                     String
  barcode                         String?
  status                          OrderStatus               @default(PENDING)
  totalAmount                     Decimal                   @db.Decimal(10, 2)
  shippingAmount                  Decimal                   @default(0) @db.Decimal(10, 2)
  discountAmount                  Decimal                   @default(0) @db.Decimal(10, 2)
  shippingDeadline                DateTime?
  shippingMethod                  String?
  trackingCode                    String?
  currentDepartmentId             String?
  customerName                    String
  customerEmail                   String?
  customerPhone                   String?
  shippingAddress                 Json?
  notes                           String?
  paymentMethod                   String?
  paidAt                          DateTime?
  shippedAt                       DateTime?
  deliveredAt                     DateTime?
  createdById                     String?
  updatedById                     String?
  createdAt                       DateTime                  @default(now())
  updatedAt                       DateTime
  tenantId                        String
  messages                        messages[]
  order_items                     order_items[]
  order_status_history            order_status_history[]
  users_orders_createdByIdTousers users?                    @relation("orders_createdByIdTousers", fields: [createdById], references: [id])
  departments                     departments?              @relation(fields: [currentDepartmentId], references: [id])
  marketplace_integrations        marketplace_integrations? @relation(fields: [integrationId], references: [id])
  tenants                         tenants                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users_orders_updatedByIdTousers users?                    @relation("orders_updatedByIdTousers", fields: [updatedById], references: [id])
  shipping_labels                 shipping_labels[]
  tasks                           tasks[]

  @@unique([tenantId, barcode])
  @@unique([tenantId, orderNumber])
}

model payments {
  id             String        @id
  subscriptionId String
  amount         Decimal       @db.Decimal(10, 2)
  status         PaymentStatus @default(PENDING)
  method         String?
  externalId     String?
  paidAt         DateTime?
  dueDate        DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  subscriptions  subscriptions @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model plans {
  id            String          @id
  name          String
  description   String?
  price         Decimal         @db.Decimal(10, 2)
  billingCycle  String
  maxUsers      Int             @default(5)
  maxProducts   Int             @default(100)
  maxOrders     Int             @default(1000)
  features      Json
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  subscriptions subscriptions[]
}

model product_groups {
  id          String     @id
  name        String
  description String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  tenantId    String
  tenants     tenants    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    products[]
}

model product_images {
  id        String   @id
  productId String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  products  products @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model products {
  id             String           @id
  sku            String
  name           String
  description    String
  cost           Decimal          @default(0) @db.Decimal(10, 2)
  price          Decimal          @db.Decimal(10, 2)
  stock          Int              @default(0)
  physicalStock  Int              @default(0)
  minStock       Int              @default(0)
  weight         Decimal?         @db.Decimal(10, 3)
  height         Decimal?         @db.Decimal(10, 2)
  width          Decimal?         @db.Decimal(10, 2)
  length         Decimal?         @db.Decimal(10, 2)
  barcode        String?
  active         Boolean          @default(true)
  categoryId     String?
  productGroupId String?
  departmentId   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  tenantId       String
  listings       listings[]
  order_items    order_items[]
  product_images product_images[]
  categories     categories?      @relation(fields: [categoryId], references: [id])
  departments    departments?     @relation(fields: [departmentId], references: [id])
  product_groups product_groups?  @relation(fields: [productGroupId], references: [id])
  tenants        tenants          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, barcode])
  @@unique([tenantId, sku])
}

model questions {
  id           String         @id
  listingId    String
  externalId   String?
  customerName String
  question     String
  answer       String?
  status       QuestionStatus @default(PENDING)
  answeredAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  listings     listings       @relation(fields: [listingId], references: [id])
}

model shipping_labels {
  id           String    @id
  orderId      String
  labelUrl     String?
  trackingCode String?
  carrier      String?
  printed      Boolean   @default(false)
  printedAt    DateTime?
  createdAt    DateTime  @default(now())
  orders       orders    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model subscriptions {
  id                 String             @id
  tenantId           String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIAL)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  payments           payments[]
  plans              plans              @relation(fields: [planId], references: [id])
  tenants            tenants            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model task_assignments {
  id        String   @id
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  tasks     tasks    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

model tasks {
  id               String             @id
  orderId          String?
  departmentId     String?
  title            String
  description      String?
  dueDate          DateTime
  priority         TaskPriority       @default(MEDIUM)
  status           TaskStatus         @default(PENDING)
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  tenantId         String
  task_assignments task_assignments[]
  departments      departments?       @relation(fields: [departmentId], references: [id])
  orders           orders?            @relation(fields: [orderId], references: [id])
  tenants          tenants            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model tenants {
  id                       String                     @id
  name                     String
  subdomain                String                     @unique
  domain                   String?
  logo                     String?
  active                   Boolean                    @default(true)
  trialEndsAt              DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime
  auditLogs                AuditLog[]
  categories               categories[]
  departments              departments[]
  marketplace_integrations marketplace_integrations[]
  orders                   orders[]
  product_groups           product_groups[]
  products                 products[]
  subscriptions            subscriptions?
  tasks                    tasks[]
  transactions             transactions[]
  users                    users[]
}

model transactions {
  id            String          @id
  type          TransactionType
  category      String
  description   String
  amount        Decimal         @db.Decimal(10, 2)
  date          DateTime
  paymentMethod String?
  reference     String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  tenantId      String
  tenants       tenants         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model user_departments {
  id           String      @id
  userId       String
  departmentId String
  createdAt    DateTime    @default(now())
  departments  departments @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users        users       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
}

model users {
  id                               String             @id
  email                            String
  password                         String
  name                             String
  role                             UserRole           @default(OPERATOR)
  active                           Boolean            @default(true)
  createdAt                        DateTime           @default(now())
  updatedAt                        DateTime
  tenantId                         String
  auditLogs                        AuditLog[]
  messages                         messages[]
  orders_orders_createdByIdTousers orders[]           @relation("orders_createdByIdTousers")
  orders_orders_updatedByIdTousers orders[]           @relation("orders_updatedByIdTousers")
  task_assignments                 task_assignments[]
  user_departments                 user_departments[]
  tenants                          tenants            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
}

model workflow_steps {
  id                                                       String      @id
  fromDepartmentId                                         String
  toDepartmentId                                           String
  order                                                    Int         @default(0)
  active                                                   Boolean     @default(true)
  createdAt                                                DateTime    @default(now())
  updatedAt                                                DateTime
  departments_workflow_steps_fromDepartmentIdTodepartments departments @relation("workflow_steps_fromDepartmentIdTodepartments", fields: [fromDepartmentId], references: [id])
  departments_workflow_steps_toDepartmentIdTodepartments   departments @relation("workflow_steps_toDepartmentIdTodepartments", fields: [toDepartmentId], references: [id])
}

enum ListingStatus {
  ACTIVE
  PAUSED
  CLOSED
  INACTIVE
}

enum MarketplaceType {
  MERCADO_LIVRE
  SHOPEE
  AMAZON
  MAGALU
  OTHER
}

enum MessageSender {
  CUSTOMER
  SELLER
  SYSTEM
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum QuestionStatus {
  PENDING
  ANSWERED
  ARCHIVED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TransactionType {
  REVENUE
  EXPENSE
  INVESTMENT
}

enum UserRole {
  ADMIN
  MANAGER
  OPERATOR
  VIEWER
  SUPER_ADMIN
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String?
  action      String
  entity      String
  entityId    String?
  changes     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  tenant      tenants  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        users?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}
